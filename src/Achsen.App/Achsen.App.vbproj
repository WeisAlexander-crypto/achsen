<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ist auf CATIA-V5-Arbeitsplaetzen in der Regel vorhanden -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Achsen.App</RootNamespace>
    <AssemblyName>Achsen</AssemblyName>
    <StartupObject>Achsen.App.Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Achsen.Core\Achsen.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\regeln_standard.json" Link="config\regeln_standard.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
